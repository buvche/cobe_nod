# СЛОБО node Modelfile — rendered by cobe-nod.sh
# @@BASE@@ is substituted with the base model chosen for this hardware.
# @@CTX@@  is substituted with the context window this node's RAM can hold.
# @@THREADS@@ is the number of fast cores to use (on RK3588: the 4 A76s only —
#           including the slow A55s makes generation slower, not faster).
FROM @@BASE@@
PARAMETER temperature 0.6
PARAMETER top_p 0.9
PARAMETER num_ctx @@CTX@@
PARAMETER num_thread @@THREADS@@
